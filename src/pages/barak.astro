---
import Base from '../layouts/Base.astro';

const stats = [
  { k: '18 ar', v: '1800 m² · 40 × 45 m' },
  { k: '10 min', v: 'do Lublina' },
  { k: '250 zł/m²', v: 'cena działki nr 6' },
];
const features = [
  'Działki o nieurozmaiconym ukształtowaniu — płaski, łatwy do zabudowy teren.',
  'W pobliżu sklep spożywczy oraz przystanek autobusowy.',
  'W okolicy zabudowa jednorodzinna, cisza, spokój i dużo terenów zielonych.',
  'Wymiary pozwalają wybudować dom jednorodzinny ze sporym ogrodem lub 2 domy (możliwość podziału na działki 9-arowe).',
  'Działki nie są jeszcze uzbrojone, ale w pobliżu jest prąd i woda.',
  'Bardzo dobre miejsce dla rodzin z dziećmi.',
];
---
<Base title="Działki w miejscowości Barak — Artur Gładosz">
  <div style="background:#f6f4ef;color:#1c1b18;min-height:100vh">

    <header style="position:sticky;top:0;z-index:50;backdrop-filter:blur(10px);background:rgba(246,244,239,0.82);border-bottom:1px solid rgba(28,27,24,0.08)">
      <div style="max-width:1000px;margin:0 auto;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px">
        <a href="/" style="display:flex;align-items:center;gap:12px">
          <span style="display:grid;place-items:center;width:40px;height:40px;border:1px solid #1c1b18;border-radius:50%;font-family:'Newsreader',serif;font-size:18px;letter-spacing:-0.5px;color:#1c1b18">AG</span>
          <span style="font-family:'Newsreader',serif;font-size:19px;letter-spacing:-0.2px;color:#1c1b18">Artur Gładosz</span>
        </a>
        <a href="/nieruchomosci" style="display:inline-flex;align-items:center;gap:8px;font-size:14.5px;font-weight:600;color:#1c1b18">← Nieruchomości</a>
      </div>
    </header>

    <section style="max-width:1000px;margin:0 auto;padding:64px 28px 44px">
      <div style="font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#2f5d74;margin-bottom:16px">Nieruchomości · Gmina Jastków</div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(38px,6vw,64px);line-height:1.02;letter-spacing:-1.4px;margin-bottom:22px">Działki w miejscowości Barak</h1>
      <p style="font-size:18px;line-height:1.6;opacity:0.78;max-width:620px">Nowoczesna i rozwijająca się gmina na północny-zachód od Lublina. Cisza, spokój i dużo terenów zielonych — a do Lublina dojedziesz w 10 minut.</p>
      <div style="display:flex;flex-wrap:wrap;gap:30px;margin-top:36px;padding-top:30px;border-top:1px solid rgba(28,27,24,0.1)">
        {stats.map((s) => (
          <div>
            <div style="font-family:'Newsreader',serif;font-size:30px;letter-spacing:-0.5px">{s.k}</div>
            <div style="font-size:13.5px;opacity:0.6;margin-top:2px">{s.v}</div>
          </div>
        ))}
      </div>
    </section>

    <section style="max-width:1000px;margin:0 auto;padding:0 28px 44px;display:grid;grid-template-columns:1fr 1fr;gap:24px">
      <div style="background:#fff;border:1px solid rgba(28,27,24,0.09);border-radius:16px;overflow:hidden">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d39938.82428714776!2d22.48143484005727!3d51.271069781427215!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTHCsDE3JzE2LjMiTiAyMsKwMjgnMjUuNCJF!5e0!3m2!1spl!2spl!4v1596037806448!5m2!1spl!2spl" style="width:100%;height:320px;border:0;display:block" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        <div style="padding:20px 24px">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;margin-bottom:5px">Lokalizacja</h3>
          <p style="font-size:14.5px;opacity:0.7;line-height:1.5">Barak, gmina Jastków (woj. lubelskie) · 51°17'16.3"N 22°28'25.4"E</p>
        </div>
      </div>
      <div style="background:#fff;border:1px solid rgba(28,27,24,0.09);border-radius:16px;overflow:hidden;display:flex;flex-direction:column">
        <div style="flex:1;background:#fafafa;display:grid;place-items:center;padding:12px">
          <img src="/images/barak-mapa.jpg" alt="Mapa projektu połączenia i podziału działek" style="max-width:100%;max-height:420px;object-fit:contain;display:block" />
        </div>
        <div style="padding:20px 24px;border-top:1px solid rgba(28,27,24,0.09)">
          <h3 style="font-family:'Newsreader',serif;font-weight:500;font-size:20px;margin-bottom:5px">Mapa podziału działek</h3>
          <p style="font-size:14.5px;opacity:0.7;line-height:1.5">Stan po połączeniu i podziale — na niebiesko oznaczono działki nr 5 i 6.</p>
        </div>
      </div>
    </section>

    <section style="max-width:1000px;margin:0 auto;padding:0 28px 20px">
      <div style="background:#1c1b18;color:#f6f4ef;border-radius:20px;padding:44px 44px;display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center">
        <div>
          <div style="font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#dde6ec;margin-bottom:16px">Oferta aktualna</div>
          <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(28px,3.4vw,40px);line-height:1.06;letter-spacing:-0.8px;margin-bottom:16px">Do sprzedania działka nr 6</h2>
          <p style="font-size:16px;line-height:1.6;opacity:0.82">Do działki doprowadzone jest przyłącze elektryczne (stan na 04.01.2023). W pobliżu prąd i woda.</p>
        </div>
        <div style="display:flex;flex-direction:column;gap:14px">
          <div style="border:1px solid rgba(246,244,239,0.16);border-radius:12px;padding:20px 22px">
            <div style="font-size:13px;opacity:0.6;margin-bottom:4px">Cena orientacyjna</div>
            <div style="font-family:'Newsreader',serif;font-size:30px">450 000 zł</div>
            <div style="font-size:13.5px;opacity:0.7;margin-top:2px">250 zł / m² · działka 18 ar</div>
          </div>
          <a href="tel:+48667224896" style="display:flex;align-items:center;justify-content:space-between;background:#f6f4ef;color:#1c1b18;border-radius:12px;padding:16px 22px;font-weight:600;transition:transform 0.3s cubic-bezier(0.22,1,0.36,1),box-shadow 0.3s ease" style-hover="transform:translateY(-3px);box-shadow:0 14px 30px rgba(0,0,0,0.25)">
            <span>Zadzwoń · 667 224 896</span><span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section style="max-width:1000px;margin:0 auto;padding:44px 28px">
      <h2 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(26px,3.2vw,38px);letter-spacing:-0.8px;margin-bottom:26px">Charakterystyka działek</h2>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px">
        {features.map((f) => (
          <div style="background:#fff;border:1px solid rgba(28,27,24,0.09);border-radius:14px;padding:22px 24px;display:flex;gap:14px;align-items:flex-start;transition:transform 0.3s cubic-bezier(0.22,1,0.36,1),box-shadow 0.3s ease,border-color 0.3s ease" style-hover="transform:translateY(-4px);box-shadow:0 16px 34px rgba(28,27,24,0.1);border-color:rgba(28,27,24,0.2)">
            <span style="color:#2f5d74;font-weight:700;font-family:'Newsreader',serif;font-size:18px">·</span>
            <p style="font-size:15.5px;line-height:1.55;opacity:0.85">{f}</p>
          </div>
        ))}
      </div>
    </section>

    <section style="max-width:1000px;margin:0 auto;padding:0 28px 44px">
      <div style="background:#f0ede6;border:1px solid rgba(28,27,24,0.1);border-radius:16px;padding:34px 36px">
        <h2 style="font-family:'Newsreader',serif;font-weight:500;font-size:23px;margin-bottom:8px">Plan zagospodarowania (MPZP)</h2>
        <p style="font-size:15px;line-height:1.66;opacity:0.82;margin-bottom:16px">Wg Uchwały nr XVI/118/2000 Rady Gminy Jastków, teren oznaczony jako <strong>1.5 MR — mieszkalnictwo rolnicze</strong>. Dopuszcza się podział na działki budowlane o pow. min. 1800 m², minimalna szerokość 25 m, zabudowa do 20% powierzchni działki, wysokość do 2 kondygnacji (kalenica do 11 m).</p>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <a href="https://www.arturgladosz.pl/wp-content/uploads/2020/07/Pełna-Treść-uchwały-mpzp.pdf" target="_blank" style="display:inline-flex;align-items:center;gap:8px;background:#1c1b18;color:#f6f4ef;padding:12px 22px;border-radius:999px;font-weight:600;font-size:14.5px;transition:background 0.3s ease,transform 0.3s cubic-bezier(0.22,1,0.36,1)" style-hover="background:#2f5d74;transform:translateY(-2px)">Pełna treść uchwały (PDF) ↗</a>
          <a href="https://jastkow.e-mapa.net?userview=516" target="_blank" style="display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(28,27,24,0.25);padding:12px 22px;border-radius:999px;font-weight:600;font-size:14.5px;color:#1c1b18;transition:border-color 0.3s ease,transform 0.3s cubic-bezier(0.22,1,0.36,1)" style-hover="border-color:#1c1b18;transform:translateY(-2px)">System informacji przestrzennej ↗</a>
        </div>
      </div>
    </section>

    <footer style="border-top:1px solid rgba(28,27,24,0.1);background:#f0ede6">
      <div style="max-width:1000px;margin:0 auto;padding:34px 28px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between">
        <span style="font-size:14px;opacity:0.6">© 2026 Artur Gładosz · arturgladosz.pl</span>
        <a href="/" style="font-size:14px;font-weight:500;color:#2f5d74">← Strona główna</a>
      </div>
    </footer>

  </div>
</Base>
