---
import Base from '../layouts/Base.astro';

const games = [
  { icon: '🎲', title: 'Liczenie punktów', desc: 'Licznik do planszówek. Offline na jednym telefonie albo online, gdy każdy wpisuje swoje punkty, z historią rund i eksportem do Excela.', href: '/punkty/' },
  { icon: '🟪', title: 'Płytki online', desc: 'Gra w układanie płytek według koloru i kształtu, dla 1–4 graczy na telefonach. Punkty liczą się same.', href: '/punkty/plytki/' },
];
---
<Base title="Gry — Artur Gładosz">
  <div style="background:#f6f4ef;color:#1c1b18;min-height:100vh;display:flex;flex-direction:column">

    <header style="position:sticky;top:0;z-index:50;backdrop-filter:blur(10px);background:rgba(246,244,239,0.82);border-bottom:1px solid rgba(28,27,24,0.08)">
      <div style="max-width:820px;margin:0 auto;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px">
        <a href="/" style="display:flex;align-items:center;gap:12px">
          <span style="display:grid;place-items:center;width:40px;height:40px;border:1px solid #1c1b18;border-radius:50%;font-family:'Newsreader',serif;font-size:18px;letter-spacing:-0.5px;color:#1c1b18">AG</span>
          <span style="font-family:'Newsreader',serif;font-size:19px;letter-spacing:-0.2px;color:#1c1b18">Artur Gładosz</span>
        </a>
        <a href="/" style="display:inline-flex;align-items:center;gap:8px;font-size:14.5px;font-weight:600;color:#1c1b18">← Powrót</a>
      </div>
    </header>

    <div style="max-width:820px;margin:0 auto;padding:72px 28px 48px;width:100%">
      <div style="font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#2f5d74;margin-bottom:16px">Po godzinach</div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(38px,6vw,58px);line-height:1.03;letter-spacing:-1.2px;margin-bottom:20px">Gry</h1>
      <p style="font-size:17px;line-height:1.6;opacity:0.72;max-width:560px">Narzędzia do wspólnego grania przy stole — działają w przeglądarce telefonu, bez instalowania aplikacji.</p>
    </div>

    <main style="max-width:820px;margin:0 auto;padding:0 28px 96px;width:100%;flex:1;display:flex;flex-direction:column;gap:16px">
      {games.map((g) => (
        <a href={g.href} style="display:flex;align-items:center;gap:20px;background:#fff;border:1px solid rgba(28,27,24,0.1);border-radius:16px;padding:28px 30px;color:#1c1b18;transition:transform 0.3s cubic-bezier(0.22,1,0.36,1),box-shadow 0.3s ease,border-color 0.3s ease" style-hover="border-color:#1c1b18;transform:translateY(-4px);box-shadow:0 18px 40px rgba(28,27,24,0.1)">
          <span style="font-size:34px;line-height:1;flex-shrink:0" aria-hidden="true">{g.icon}</span>
          <span style="flex:1">
            <span style="display:block;font-family:'Newsreader',serif;font-size:24px;letter-spacing:-0.3px;margin-bottom:5px">{g.title}</span>
            <span style="display:block;font-size:14.5px;opacity:0.65;line-height:1.5">{g.desc}</span>
          </span>
          <span style="color:#2f5d74;font-size:24px;flex-shrink:0">→</span>
        </a>
      ))}
    </main>

    <footer style="border-top:1px solid rgba(28,27,24,0.1);background:#f0ede6">
      <div style="max-width:820px;margin:0 auto;padding:34px 28px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between">
        <span style="font-size:14px;opacity:0.6">© 2026 Artur Gładosz · arturgladosz.pl</span>
        <a href="/" style="font-size:14px;font-weight:500;color:#2f5d74">← Strona główna</a>
      </div>
    </footer>

  </div>
</Base>
