---
import Base from '../layouts/Base.astro';

const items = [
  { title: 'Barak, gmina Jastków', region: 'Woj. lubelskie', desc: 'Działki 18 ar (40 × 45 m) blisko Lublina — 10 minut do miasta. Aktualnie dostępna działka nr 6.', img: '/images/barak-mapa.jpg', href: '/barak' },
  { title: 'Niwiska', region: 'Woj. podkarpackie', desc: 'Działki 8,86 i 11,28 ara w okolicy Kolbuszowej, Mielca i Rzeszowa. Media w zasięgu, dostęp do drogi asfaltowej.', img: '/images/niwiska-1.jpg', href: '/niwiska' },
];
---
<Base title="Nieruchomości — Artur Gładosz">
  <div style="background:#f6f4ef;color:#1c1b18;min-height:100vh;display:flex;flex-direction:column">

    <header style="position:sticky;top:0;z-index:50;backdrop-filter:blur(10px);background:rgba(246,244,239,0.82);border-bottom:1px solid rgba(28,27,24,0.08)">
      <div style="max-width:960px;margin:0 auto;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px">
        <a href="/" style="display:flex;align-items:center;gap:12px">
          <span style="display:grid;place-items:center;width:40px;height:40px;border:1px solid #1c1b18;border-radius:50%;font-family:'Newsreader',serif;font-size:18px;letter-spacing:-0.5px;color:#1c1b18">AG</span>
          <span style="font-family:'Newsreader',serif;font-size:19px;letter-spacing:-0.2px;color:#1c1b18">Artur Gładosz</span>
        </a>
        <a href="/" style="display:inline-flex;align-items:center;gap:8px;font-size:14.5px;font-weight:600;color:#1c1b18">← Powrót</a>
      </div>
    </header>

    <div style="max-width:960px;margin:0 auto;padding:72px 28px 48px;width:100%">
      <div style="font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#2f5d74;margin-bottom:16px">Oferty</div>
      <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:clamp(38px,6vw,58px);line-height:1.03;letter-spacing:-1.2px;margin-bottom:20px">Nieruchomości</h1>
      <p style="font-size:17px;line-height:1.6;opacity:0.72;max-width:580px">Działki budowlane i inwestycyjne w województwie lubelskim i podkarpackim.</p>
    </div>

    <main style="max-width:960px;margin:0 auto;padding:0 28px 96px;width:100%;flex:1;display:grid;grid-template-columns:1fr 1fr;gap:20px">
      {items.map((it) => (
        <a href={it.href} style="display:flex;flex-direction:column;background:#fff;border:1px solid rgba(28,27,24,0.1);border-radius:18px;overflow:hidden;color:#1c1b18;transition:transform 0.35s cubic-bezier(0.22,1,0.36,1),box-shadow 0.35s ease,border-color 0.35s ease" style-hover="border-color:#1c1b18;transform:translateY(-6px);box-shadow:0 24px 50px rgba(28,27,24,0.14)">
          <div style="aspect-ratio:16/10;overflow:hidden;background:#eceae3">
            <img src={it.img} alt={it.title} style="width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.6s cubic-bezier(0.22,1,0.36,1)" style-hover="transform:scale(1.06)" />
          </div>
          <div style="padding:26px 28px;display:flex;flex-direction:column;gap:8px">
            <div style="font-size:12.5px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#2f5d74">{it.region}</div>
            <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
              <span style="font-family:'Newsreader',serif;font-size:26px;letter-spacing:-0.4px">{it.title}</span>
              <span style="color:#2f5d74;font-size:22px">→</span>
            </div>
            <p style="font-size:14.5px;line-height:1.55;opacity:0.72">{it.desc}</p>
          </div>
        </a>
      ))}
    </main>

    <footer style="border-top:1px solid rgba(28,27,24,0.1);background:#f0ede6">
      <div style="max-width:960px;margin:0 auto;padding:34px 28px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:space-between">
        <span style="font-size:14px;opacity:0.6">© 2026 Artur Gładosz · arturgladosz.pl</span>
        <a href="/" style="font-size:14px;font-weight:500;color:#2f5d74">← Strona główna</a>
      </div>
    </footer>

  </div>
</Base>
